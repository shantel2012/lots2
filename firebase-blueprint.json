{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "A parking space booking made by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user who made the booking." },
        "spotId": { "type": "string", "description": "The ID of the parking spot." },
        "spotName": { "type": "string", "description": "The name of the parking spot." },
        "startTime": { "type": "string", "format": "date-time", "description": "When the booking starts." },
        "endTime": { "type": "string", "format": "date-time", "description": "When the booking ends." },
        "status": { "type": "string", "enum": ["active", "cancelled", "completed"], "description": "The current status of the booking." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the booking record was created." }
      },
      "required": ["userId", "spotId", "spotName", "startTime", "status", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection of all parking bookings."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    }
  }
}
